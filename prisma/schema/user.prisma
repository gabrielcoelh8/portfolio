model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  name      String?
  title     String?
  education String?
  email     String   @unique
  cv        String
  linkedin  String   @unique
  github    String   @unique

  projects  Project[]
  stacks    Stack[]
}