{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Next.js",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "node",
        "runtimeArgs": ["--inspect-brk", "node_modules/next/dist/bin/next", "dev"],
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "skipFiles": ["<node_internals>/**"]
      },
      {
        "name": "Attach to Next.js",
        "type": "node",
        "request": "attach",
        "port": 9229,
        "restart": true
      }
    ]
  }
  